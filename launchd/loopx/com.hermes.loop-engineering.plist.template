<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hermes.loop-engineering</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{LOOPX}}</string>
		<string>scheduler</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LOOP_ENGINEERING_HOME</key>
		<string>{{LOOP_DIR}}</string>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:{{HOME}}/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardErrorPath</key>
	<string>{{LOOP_DIR}}/outputs/history/launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>{{LOOP_DIR}}/outputs/history/launchd.out.log</string>
	<key>StartInterval</key>
	<integer>900</integer>
</dict>
</plist>
