<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hermes.loop-engineering-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{PYTHON3}}</string>
    <string>{{LOOP_DIR}}/bin/web/dashboard_server.py</string>
    <string>{{PORT}}</string>
  </array>
  <key>StandardOutPath</key>
  <string>{{LOOP_DIR}}/outputs/history/dashboard.out.log</string>
  <key>StandardErrorPath</key>
  <string>{{LOOP_DIR}}/outputs/history/dashboard.err.log</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
